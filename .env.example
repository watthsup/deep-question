# ---- Provider selection -------------------------------------------------
# auto     -> use Bedrock if AWS_BEARER_TOKEN_BEDROCK is set, else Anthropic direct.
#             When both are set, Bedrock is primary and Anthropic is the automatic fallback.
# bedrock  -> Bedrock only
# anthropic-> Anthropic direct only
LLM_PROVIDER=auto

# ---- Amazon Bedrock (no boto3: Bedrock Messages-API endpoint + bearer API key) ----
# Create a Bedrock API key in the AWS console (Bedrock > API keys) and paste it here.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
# Bedrock model IDs carry the "anthropic." prefix.
BEDROCK_MODEL_ID=anthropic.claude-opus-5

# ---- Anthropic direct (fallback / alternative) ----------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-opus-5

# ---- Generation knobs -----------------------------------------------------
# low | medium | high | xhigh | max   (thinking is adaptive; effort controls depth)
LLM_EFFORT=high
# Output budget per catalog. Thinking tokens count against it and Thai is token-heavy;
# 16000 truncated real runs. Requests stream, so large values are fine.
LLM_MAX_TOKENS=48000
